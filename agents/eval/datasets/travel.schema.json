{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jur'ah evaluation set: foreign medicine packaging",
  "description": "Photos of real foreign medicine packaging with the brand and active ingredient(s) printed on it. Scored as identification (AI Agents Acceptance Criteria section 5): the Travel Check must resolve the photo to exactly the expected ingredients.",
  "type": "object",
  "required": ["set", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "set": { "const": "travel" },
    "owed": { "type": "string", "description": "The owed-value marker of an empty set. Delete it once the set holds its minimum." },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "expected", "suppliedBy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "file": { "type": "string", "pattern": "\\.(jpe?g|png|webp|heic|heif)$", "description": "The photo, relative to the data file." },
          "expected": {
            "type": "object",
            "required": ["brand", "ingredients"],
            "additionalProperties": false,
            "properties": {
              "brand": { "type": "string", "minLength": 1, "description": "The trade name printed on the box." },
              "ingredients": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } }
            }
          },
          "country": { "type": "string", "minLength": 2 },
          "suppliedBy": { "type": "string", "minLength": 2 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
