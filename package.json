{
  "name": "jurah-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Jur'ah (جرعة) — Phase 1 frontend. Medication-safety platform for patients in Kuwait. Capstone project.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:tokens && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "check:tokens": "tsx scripts/build-tokens.ts --check",
    "guards": "tsx scripts/guards/run.ts",
    "seed:diff": "tsx scripts/seed-diff.ts",
    "notes:check": "tsx scripts/notes-check.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:dump": "tsx scripts/db/dump.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:tokens && npm run guards && npm run test && npm run seed:diff && npm run notes:check && next build"
  },
  "dependencies": {
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react": "7.37.5",
    "ical.js": "2.2.1",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "type": "module"
}
