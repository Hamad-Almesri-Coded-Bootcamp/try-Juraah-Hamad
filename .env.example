# Jur'ah — Phase 1 makes no network call. These exist so Phase 2 changes values, not code.
# Never put a secret here or in the repository: the bot token and the VAPID private key are server-side only.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_BOT_HANDLE=@jurah_bot
NEXT_PUBLIC_PUSH_PUBLIC_KEY=phase-2-vapid-public-key-placeholder

# ---- Phase 2 (server-side only — none of these is NEXT_PUBLIC_, none may ever be committed with a value) ----
# Which implementation sits behind the seam. vitest and `npm run verify` use mock; next dev/start use postgres.
JURAH_DATA_BACKEND=mock
# Transaction-pooler connection string for the Supabase project `jurah` (D-015). Owner-supplied.
JURAH_DATABASE_URL=
# 32 random bytes, base64 — signs the session cookie (D-018). Owner-supplied.
JURAH_SESSION_SECRET=
# Bearer credential for the agent integration point (app/api/agent/**). Owner-supplied.
JURAH_AGENT_TOKEN=
# Bearer credential for the expiry job (app/api/jobs/**). Owner-supplied.
JURAH_JOB_TOKEN=
# CR-063: the n8n inbound workflow the Telegram webhook forwards chat replies to — its /webhook/ URL,
# never /webhook-test/ — and the header secret sent with it (x-jurah-secret). Owner-supplied. Empty → nothing forwarded.
JURAH_AGENT_INBOUND_URL=
JURAH_AGENT_INBOUND_SECRET=
# CR-067: the n8n agent-webchat workflow the web assistant asks (its /webhook/ URL). Not a secret; uses the inbound secret above.
JURAH_AGENT_CHAT_URL=
# CR-066: the drug-knowledge agents the seam calls (each a /webhook/ URL; not secrets; they use the inbound
# secret above). Empty → that screen keeps its deterministic stub.
#   travel check  → the C3 drug-photo check        e.g. https://<n8n>/webhook/jurah/travel-check
#   extraction    → the B4 prescription photo      e.g. https://<n8n>/webhook/jurah/extract-prescription
#   screening     → every saved prescription       e.g. https://<n8n>/webhook/jurah/screen-prescription
JURAH_AGENT_TRAVEL_CHECK_URL=
JURAH_AGENT_EXTRACTION_URL=
JURAH_AGENT_SCREENING_URL=
# Telegram bot token — no bot exists yet; stays empty until the owner creates one.
JURAH_BOT_TOKEN=
# VAPID private key; the public half goes to NEXT_PUBLIC_PUSH_PUBLIC_KEY above.
JURAH_VAPID_PRIVATE_KEY=
# The deployment's own origin (e.g. https://jurah.example) — builds the calendar feed's webcal:// URL
# and the VAPID subject. Not a secret. Defaults to http://localhost:3000 when empty.
JURAH_APP_ORIGIN=
